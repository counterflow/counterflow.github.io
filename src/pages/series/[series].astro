---
import PageShell from "../../components/PageShell.astro";
import { getSeries, getAllSeriesSlugs } from "../../utils/getPosts";

export async function getStaticPaths() {
  return getAllSeriesSlugs().map((series) => ({ params: { series } }));
}

const { series: seriesSlug } = Astro.params;

if (!seriesSlug) {
  return Astro.redirect("/posts/");
}

const series = getSeries(seriesSlug);

if (!series) {
  return Astro.redirect("/posts/");
}

const complete = series.parts.length >= series.partsTotal;
const description =
  series.parts[0]?.description || `A ${series.partsTotal}-part series.`;
---

<PageShell
  title={`${series.title} - Counterflow`}
  description={description}
  image={series.parts[0]?.image}
>
  <section
    class="relative z-20 mx-auto mt-24 mb-12 w-full max-w-[896px] px-4 sm:px-6 lg:px-8"
  >
    <header class="mb-12">
      <span
        class="inline-flex items-center rounded-full border border-dashed border-neutral-300 px-3 py-1 text-xs font-medium text-neutral-600 dark:border-neutral-600 dark:text-neutral-400"
      >
        Series · {series.partsTotal} part{series.partsTotal === 1 ? "" : "s"}
        {!complete && ` · ${series.parts.length} published`}
      </span>
      <h1
        class="mt-4 text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-3xl lg:text-4xl"
      >
        {series.title}
      </h1>
      <p class="mt-3 text-base text-neutral-600 dark:text-neutral-400 sm:text-lg">
        {description}
      </p>
    </header>

    <ol class="flex flex-col gap-4">
      {
        series.parts.map((part, index) => (
          <li>
            <a
              href={part.href}
              class="group flex gap-5 rounded-2xl border border-dashed border-neutral-300 p-5 transition-all duration-300 ease-out hover:-translate-x-1 hover:-translate-y-1 hover:bg-white/70 dark:border-neutral-700 dark:hover:bg-neutral-950/50"
            >
              <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full border border-neutral-300 text-sm font-semibold text-neutral-600 dark:border-neutral-600 dark:text-neutral-400">
                {part.part ?? index + 1}
              </span>
              <span class="min-w-0">
                <span class="block text-base font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-lg">
                  {part.title}
                </span>
                <span class="mt-1 block text-sm text-neutral-600 dark:text-neutral-400">
                  {part.description}
                </span>
                <span class="mt-2 flex items-center gap-3 text-xs text-neutral-500 dark:text-neutral-500">
                  <span>{part.date}</span>
                  <span>{part.readTime}</span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <div class="mt-10">
      <a
        href="/posts/"
        class="text-sm font-medium text-neutral-600 underline underline-offset-4 transition-colors hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
      >
        ← All posts
      </a>
    </div>
  </section>
</PageShell>
