---
import PageShell from "../../components/PageShell.astro";
import Mermaid from "../../components/Mermaid.astro";
import {
  getProjectBySlug,
  getAllProjectSlugs,
  getAllProjects,
} from "../../utils/getProjects";

export async function getStaticPaths() {
  return getAllProjectSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/projects/");
}

const project = getProjectBySlug(slug);

if (!project) {
  return Astro.redirect("/projects/");
}

const { frontmatter, Content } = project;
const meta = getAllProjects().find((p) => p.slug === slug);

const ogImage = frontmatter.image || "/assets/images/projects/project1.jpg";
const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: frontmatter.title,
  description: frontmatter.description,
  image: Astro.site ? new URL(ogImage, Astro.site).href : ogImage,
  author: { "@type": "Person", name: "Ian Faigao" },
  url: canonicalURL,
};
---

<PageShell
  title={`${frontmatter.title} - Counterflow`}
  description={frontmatter.description || ""}
  image={ogImage}
>
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(jsonLd)}
  />

  <article
    class="relative z-20 mx-auto mt-24 mb-12 w-[calc(100%-2rem)] max-w-[896px] rounded-2xl border border-neutral-200/70 bg-neutral-100/85 px-6 py-10 shadow-xl shadow-neutral-900/5 backdrop-blur-sm sm:px-10 sm:py-12 lg:px-14 dark:border-neutral-700/60 dark:bg-neutral-800/75 dark:shadow-black/30"
  >
    <header>
      <a
        href="/projects/"
        class="text-sm text-neutral-600 transition-colors hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
      >
        ← Projects
      </a>

      <h1
        class="mt-6 text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-3xl lg:text-4xl"
      >
        {frontmatter.title}
      </h1>

      {
        (frontmatter.summary || frontmatter.description) && (
          <p class="mt-3 text-lg text-neutral-600 dark:text-neutral-400">
            {frontmatter.summary || frontmatter.description}
          </p>
        )
      }

      {
        meta && meta.stack.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-1.5">
            {meta.stack.map((tech) => (
              <span class="inline-flex items-center rounded-full border border-neutral-300 px-2.5 py-0.5 text-xs text-neutral-600 dark:border-neutral-600 dark:text-neutral-400">
                {tech}
              </span>
            ))}
          </div>
        )
      }

      {
        (frontmatter.url || frontmatter.repo) && (
          <div class="mt-6 flex flex-wrap gap-3">
            {frontmatter.url && (
              <a
                href={frontmatter.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center rounded-lg bg-neutral-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-neutral-700 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-300"
              >
                Visit site
              </a>
            )}
            {frontmatter.repo && (
              <a
                href={frontmatter.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center rounded-lg border border-neutral-300 px-4 py-2 text-sm font-medium text-neutral-700 transition-colors hover:border-neutral-400 hover:text-neutral-900 dark:border-neutral-600 dark:text-neutral-300 dark:hover:text-neutral-100"
              >
                Source
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      frontmatter.image && (
        <img
          src={frontmatter.image}
          alt={frontmatter.title}
          class="mt-10 aspect-[16/9] w-full rounded-xl object-cover"
        />
      )
    }

    <div class="prose prose-neutral dark:prose-invert mt-10 max-w-none">
      <Content />
    </div>
  </article>

  <Mermaid slot="body-end" />
</PageShell>
