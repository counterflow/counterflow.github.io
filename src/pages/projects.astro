---
import PageShell from "../components/PageShell.astro";
import { projectsContent } from "../config/content.ts";
import { getAllProjects } from "../utils/getProjects";

const projects = getAllProjects();

const statusStyles: Record<string, string> = {
  shipped:
    "border-emerald-500/40 text-emerald-700 dark:text-emerald-400",
  building: "border-amber-500/40 text-amber-700 dark:text-amber-400",
  archived: "border-neutral-400/40 text-neutral-500 dark:text-neutral-500",
};
---

<PageShell
  title={projectsContent.meta.title}
  description={projectsContent.meta.description}
>
  <section class="relative z-20 max-w-4xl mx-auto mt-32 mb-12 px-7 lg:px-0">
    {
      projects.length === 0 ? (
        <div class="relative z-20 mx-auto flex w-full flex-col items-center py-24 text-center lg:mx-0">
          <h2 class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-4xl lg:text-5xl">
            Projects
          </h2>
          <p class="mt-4 max-w-md text-base text-neutral-600 dark:text-neutral-400 sm:text-lg">
            Coming soon — I'm putting a few things together. Check back shortly.
          </p>
        </div>
      ) : (
        <div class="relative z-20 mx-auto w-full lg:mx-0">
          <h2 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-3xl lg:text-4xl">
            {projectsContent.title}
          </h2>
          <p class="mt-3 text-sm leading-6 text-neutral-600 dark:text-neutral-400 sm:text-base sm:leading-7 lg:text-lg lg:leading-8">
            {projectsContent.description}
          </p>

          <div class="z-50 my-8 grid w-full grid-cols-1 items-stretch gap-7 sm:grid-cols-2 sm:gap-5">
            {projects.map((project) => (
              <a
                href={project.href}
                class="group relative flex flex-col items-stretch rounded-2xl p-7 duration-300 ease-out sm:p-3"
              >
                <span class="absolute inset-0 z-20 block h-full w-full rounded-2xl border border-transparent border-dashed bg-transparent duration-300 ease-out group-hover:-translate-x-1 group-hover:-translate-y-1 group-hover:border group-hover:border-dashed group-hover:border-neutral-300 group-hover:bg-white dark:group-hover:border-neutral-600 dark:group-hover:bg-neutral-950" />
                <span class="absolute inset-0 z-10 block h-full w-full rounded-2xl border border-dashed border-neutral-300 duration-300 ease-out group-hover:translate-x-1 group-hover:translate-y-1 dark:border-neutral-600" />
                <span class="relative z-30 block duration-300 ease-out group-hover:-translate-x-1 group-hover:-translate-y-1">
                  <span class="block w-full">
                    <img
                      src={project.image}
                      alt={project.title}
                      loading="lazy"
                      class="aspect-[16/9] h-auto w-full rounded-lg object-cover"
                    />
                  </span>
                  <span class="mb-1 mt-5 block w-full px-1 sm:mt-3">
                    <span class="mb-1 flex items-center text-base font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
                      <span>{project.title}</span>
                      <svg
                        class="ml-1 h-2.5 w-2.5 -translate-x-1 translate-y-1 -rotate-45 transform stroke-current transition-all duration-200 ease-in-out group-hover:translate-x-0 group-hover:translate-y-0"
                        viewBox="0 0 13 15"
                      >
                        <g
                          stroke="none"
                          stroke-width="1"
                          fill="none"
                          fill-rule="evenodd"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <g
                            transform="translate(0.666667, 2.333333)"
                            stroke="currentColor"
                            stroke-width="2.4"
                          >
                            <g>
                              <polyline
                                class="opacity-0 transition-all delay-0 duration-200 ease-out group-hover:opacity-100"
                                points="5.33333333 0 10.8333333 5.5 5.33333333 11"
                              />
                              <line
                                class="-translate-x-1 transform opacity-0 transition-all duration-200 ease-out group-hover:ml-0 group-hover:translate-x-0 group-hover:opacity-100"
                                x1="10.8333333"
                                y1="5.5"
                                x2="0.833333333"
                                y2="5.16666667"
                              />
                            </g>
                          </g>
                        </g>
                      </svg>
                    </span>
                    <span class="block text-sm text-neutral-600 dark:text-neutral-400">
                      {project.description}
                    </span>
                    <span class="mt-3 flex flex-wrap items-center gap-1.5">
                      <span
                        class={`inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-medium capitalize ${
                          statusStyles[project.status] ?? statusStyles.archived
                        }`}
                      >
                        {project.status}
                      </span>
                      {project.stack.slice(0, 4).map((tech) => (
                        <span class="inline-flex items-center rounded-full border border-neutral-300 px-2 py-0.5 text-[11px] text-neutral-600 dark:border-neutral-700 dark:text-neutral-400">
                          {tech}
                        </span>
                      ))}
                    </span>
                  </span>
                </span>
              </a>
            ))}
          </div>
        </div>
      )
    }
  </section>
</PageShell>
